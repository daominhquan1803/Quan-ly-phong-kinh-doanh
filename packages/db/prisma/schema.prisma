// Hoàng Gia CRM — schema dùng chung giữa apps/web và apps/worker.
// Xem plan: C:\Users\Administrator\.claude\plans\gi-p-anh-t-o-1-resilient-flute.md

generator client {
  provider      = "prisma-client-js"
  // "native" cho dev trên Windows/macOS; "linux-musl-openssl-3.0.x" cho
  // image production node:*-alpine — Alpine bản mới dùng OpenSSL 3, engine
  // musl mặc định của Prisma lại build cho OpenSSL 1.1 nên load lỗi
  // "Error loading shared library libssl.so.1.1" nếu không khai báo rõ.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  SALES
}

enum OrderStatus {
  NEW
  CONFIRMED
  PRODUCING
  PARTIAL_DELIVERED
  DELIVERED
  CANCELLED
}

enum SlipStatus {
  DRAFT
  CONFIRMED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ---------- Core ----------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  role             Role     @default(SALES)
  active           Boolean  @default(true)
  // Mã nhân viên trên AMIS (vd "DANGTAN") — dùng để khớp đơn hàng đồng bộ tự động từ AMIS
  // API chính xác hơn khớp theo tên. Điền tại trang Nhân viên.
  amisEmployeeCode String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]                @relation("OrderSalesEmployee")
  shipmentSlips    ShipmentSlip[]         @relation("SlipCreatedBy")
  salesTargets     SalesTarget[]
  importTemplates  ImportTemplate[]
  importBatches    ImportBatch[]
  employeeAliases  EmployeeAlias[]
  salesPlanLines   SalesPlanLine[]
  salesPlanBatches SalesPlanImportBatch[]

  @@map("users")
}

// Ánh xạ tên nhân viên viết khác nhau trên các nguồn dữ liệu (Excel AMIS...)
// về đúng 1 User — để lần import sau tự khớp mà không cần xử lý thủ công lại.
model EmployeeAlias {
  id         String @id @default(cuid())
  aliasName  String @unique
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  @@map("employee_aliases")
}

// ---------- Đơn hàng (import từ Excel AMIS) ----------

model ImportTemplate {
  id            String   @id @default(cuid())
  name          String
  sourceType    String   @default("AMIS_ORDER")
  headerHash    String   @unique
  columnMapping Json
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  batches ImportBatch[]

  @@map("import_templates")
}

model ImportBatch {
  id           String          @id @default(cuid())
  templateId   String?
  template     ImportTemplate? @relation(fields: [templateId], references: [id])
  fileName     String
  totalRows    Int
  createdCount Int
  updatedCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  orders Order[]

  @@map("import_batches")
}

model Order {
  id                       String       @id @default(cuid())
  orderCode                String       @unique
  // ID nội bộ của đơn hàng bên AMIS (field "id") — dùng để upsert chính xác khi đồng bộ
  // tự động, phòng trường hợp sale_order_no bị sửa bên AMIS.
  amisOrderId              Int?         @unique
  // Nguồn dữ liệu: MANUAL | EXCEL_IMPORT | AMIS_API — hiển thị cho người dùng biết đơn
  // này đến từ đâu.
  source                   String       @default("MANUAL")
  customerName             String
  customerCode             String?
  salesEmployeeNameRaw     String?
  salesEmployeeId          String?
  salesEmployee            User?        @relation("OrderSalesEmployee", fields: [salesEmployeeId], references: [id])
  orderDate                DateTime?
  expectedDeliveryDate     DateTime?
  // Ngày giao hàng thực tế — lấy từ field "delivery_date" của AMIS CRM (khác với
  // deadline_date/expectedDeliveryDate là hạn giao dự kiến). Null nếu đơn nhập thủ công/
  // Excel (không có nguồn này) hoặc AMIS chưa điền.
  actualDeliveryDate       DateTime?
  status                   OrderStatus  @default(NEW)
  totalValue               Decimal      @default(0) @db.Decimal(18, 2)
  // Giá trị hàng đã giao cộng dồn — lấy từ field "total_amount_delivered_summary" của AMIS
  // CRM. Dùng để tính "giá trị còn lại chưa giao" (totalValue - deliveredValue) cho các đơn
  // giao một phần, thay vì tính cả giá trị đơn vào phần quá hạn/sắp đến hạn. Mặc định 0 cho
  // đơn nhập tay/Excel (chưa giao gì) — khi đó giá trị còn lại = toàn bộ giá trị đơn, đúng
  // hành vi cũ.
  deliveredValue           Decimal      @default(0) @db.Decimal(18, 2)
  // true khi đơn đã được đối chiếu và sửa thủ công từ nguồn đáng tin hơn AMIS CRM (vd Sổ chi
  // tiết bán hàng bên kế toán, khi phát hiện AMIS CRM báo sai/lỗi đồng bộ nội bộ AMIS) —
  // worker sync AMIS sẽ bỏ qua hoàn toàn đơn đã đánh dấu (không ghi đè, không xoá dù AMIS báo
  // loại trừ), coi như "đã khoá" theo kết quả đối chiếu thủ công.
  deliveryVerifiedManually Boolean      @default(false)
  deliveryVerifiedNote     String?
  poCode                   String?
  rawData                  Json?
  importBatchId            String?
  importBatch              ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  shipmentSlips ShipmentSlip[]
  items         OrderItem[]

  @@index([salesEmployeeId])
  @@index([expectedDeliveryDate])
  @@index([status])
  @@map("orders")
}

// Chi tiết mã hàng/số lượng/giá của đơn hàng — đồng bộ từ AMIS
// (sale_order_product_mappings) hoặc nhập tay khi tạo đơn thủ công.
model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineOrder          Int
  itemCode           String?
  itemName           String
  unit               String?
  quantity           Decimal @default(0) @db.Decimal(14, 2)
  unitPrice          Decimal @default(0) @db.Decimal(18, 2)
  totalPrice         Decimal @default(0) @db.Decimal(18, 2)
  warehouse          String?
  poCustomerItemCode String?

  @@index([orderId])
  @@index([itemCode])
  @@map("order_items")
}

// ---------- Phiếu đi hàng (upload ảnh + OCR) ----------

model ShipmentSlip {
  id                String     @id @default(cuid())
  slipNumber        String     @unique
  slipDate          DateTime?
  receiverName      String?
  customerName      String?
  deliveryAddress   String?
  description       String?
  paymentMethod     String?
  preparedBy        String?
  imagePath         String
  imageThumbPath    String?
  orderId           String?
  order             Order?     @relation(fields: [orderId], references: [id])
  ocrRawResponse    Json?
  ocrConfidenceNote Json?
  status            SlipStatus @default(DRAFT)
  createdById       String
  createdBy         User       @relation("SlipCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  items ShipmentSlipItem[]

  @@index([orderId])
  @@index([slipDate])
  @@map("shipment_slips")
}

model ShipmentSlipItem {
  id                 String       @id @default(cuid())
  shipmentSlipId     String
  shipmentSlip       ShipmentSlip @relation(fields: [shipmentSlipId], references: [id], onDelete: Cascade)
  lineOrder          Int
  itemCode           String?
  itemName           String
  warehouse          String?
  poSaleNumber       String?
  unit               String?
  qtyRequested       Decimal?     @db.Decimal(14, 2)
  qtyActual          Decimal?     @db.Decimal(14, 2)
  poCustomerItemCode String?
  note               String?

  @@map("shipment_slip_items")
}

// ---------- Công nợ (đồng bộ từ congno.hienvi.me) ----------

model DebtSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime
  customerName    String
  customerCode    String?
  salesEmployeeId String?
  totalDebt       Decimal  @default(0) @db.Decimal(18, 2)
  overdueDebt     Decimal  @default(0) @db.Decimal(18, 2)
  agingBuckets    Json
  source          String   @default("HIENVI")
  rawData         Json?
  createdAt       DateTime @default(now())

  @@index([snapshotDate])
  @@index([customerName])
  @@map("debt_snapshots")
}

model SyncLog {
  id            String     @id @default(cuid())
  jobType       String
  status        SyncStatus
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  message       String?
  recordsSynced Int?
  triggeredBy   String?
  // Điểm đánh dấu tiến trình đồng bộ tăng dần (vd modified_date mới nhất đã xử lý của
  // AMIS) — dùng để lần chạy sau chỉ lấy dữ liệu mới/đã sửa thay vì kéo lại toàn bộ.
  cursor        String?

  @@index([jobType, startedAt])
  @@map("sync_logs")
}

// ---------- Kế hoạch kinh doanh ----------

model SalesTarget {
  id            String   @id @default(cuid())
  employeeId    String
  employee      User     @relation(fields: [employeeId], references: [id])
  year          Int
  month         Int
  targetRevenue Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@map("sales_targets")
}

// ---------- Kế hoạch kinh doanh chi tiết (import từ Excel) ----------
// Bổ sung cho SalesTarget (tổng theo nhân viên/tháng) — cho phép chi tiết hoá
// kế hoạch theo Nhân viên x Sản phẩm x Nhóm hàng, đọc từ file Excel kế hoạch.

model SalesPlanImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  year         Int
  month        Int
  totalRows    Int
  createdCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  lines SalesPlanLine[]

  @@map("sales_plan_import_batches")
}

model SalesPlanLine {
  id              String               @id @default(cuid())
  batchId         String
  batch           SalesPlanImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  employeeNameRaw String?
  employeeId      String?
  employee        User?                @relation(fields: [employeeId], references: [id])
  productCode     String?
  productName     String?
  productGroup    String?
  targetRevenue   Decimal              @default(0) @db.Decimal(18, 2)
  targetQuantity  Decimal?             @db.Decimal(14, 2)
  createdAt       DateTime             @default(now())

  @@index([year, month])
  @@index([employeeId])
  @@index([productCode])
  @@map("sales_plan_lines")
}
