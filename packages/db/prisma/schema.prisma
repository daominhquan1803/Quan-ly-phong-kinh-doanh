// Hoàng Gia CRM — schema dùng chung giữa apps/web và apps/worker.
// Xem plan: C:\Users\Administrator\.claude\plans\gi-p-anh-t-o-1-resilient-flute.md

generator client {
  provider      = "prisma-client-js"
  // "native" cho dev trên Windows/macOS; "linux-musl-openssl-3.0.x" cho
  // image production node:*-alpine — Alpine bản mới dùng OpenSSL 3, engine
  // musl mặc định của Prisma lại build cho OpenSSL 1.1 nên load lỗi
  // "Error loading shared library libssl.so.1.1" nếu không khai báo rõ.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  SALES
}

enum OrderStatus {
  NEW
  CONFIRMED
  PRODUCING
  PARTIAL_DELIVERED
  DELIVERED
  CANCELLED
}

enum SlipStatus {
  DRAFT
  CONFIRMED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum TripStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Core ----------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  role             Role     @default(SALES)
  active           Boolean  @default(true)
  // Mã nhân viên trên AMIS (vd "DANGTAN") — dùng để khớp đơn hàng đồng bộ tự động từ AMIS
  // API chính xác hơn khớp theo tên. Điền tại trang Nhân viên.
  amisEmployeeCode String?  @unique
  // Có tính vào phần thống kê doanh số theo nhân viên (Kế hoạch kinh doanh, Tổng quan) hay
  // không — mặc định true cho mọi nhân viên có amisEmployeeCode. Dùng để ẩn các tài khoản có
  // gán mã AMIS nhưng không phải nhân viên kinh doanh thật (vd tài khoản quản trị hệ thống
  // được gán mã để nhận đồng bộ đơn của 1 mã AMIS không thuộc nhân viên nào) khỏi thống kê,
  // mà vẫn giữ nguyên việc đồng bộ đơn hàng của mã đó.
  includeInSalesStats Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]                @relation("OrderSalesEmployee")
  shipmentSlips    ShipmentSlip[]         @relation("SlipCreatedBy")
  salesTargets     SalesTarget[]
  importTemplates  ImportTemplate[]
  importBatches    ImportBatch[]
  employeeAliases  EmployeeAlias[]
  salesPlanLines   SalesPlanLine[]
  salesPlanBatches SalesPlanImportBatch[]
  kpiEntries       KpiMonthlyEntry[]      @relation("KpiEmployee")
  kpiEntriesEdited KpiMonthlyEntry[]      @relation("KpiUpdatedBy")
  businessTrips    BusinessTripRequest[]  @relation("TripEmployee")
  tripApprovals    BusinessTripRequest[]  @relation("TripApprovedBy")
  defectReports    DefectReport[]         @relation("DefectEmployee")
  defectsCreated   DefectReport[]         @relation("DefectCreatedBy")
  poTrackingLines  PoTrackingLine[]
  poTrackingBatches PoTrackingImportBatch[]
  shipmentSlipBatches ShipmentSlipImportBatch[]
  manuallyClosedPoLines PoTrackingLine[] @relation("PoLineManuallyClosedBy")

  @@map("users")
}

// Ánh xạ tên nhân viên viết khác nhau trên các nguồn dữ liệu (Excel AMIS...)
// về đúng 1 User — để lần import sau tự khớp mà không cần xử lý thủ công lại.
model EmployeeAlias {
  id         String @id @default(cuid())
  aliasName  String @unique
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  @@map("employee_aliases")
}

// ---------- Đơn hàng (import từ Excel AMIS) ----------

model ImportTemplate {
  id            String   @id @default(cuid())
  name          String
  sourceType    String   @default("AMIS_ORDER")
  headerHash    String   @unique
  columnMapping Json
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  batches ImportBatch[]

  @@map("import_templates")
}

model ImportBatch {
  id           String          @id @default(cuid())
  templateId   String?
  template     ImportTemplate? @relation(fields: [templateId], references: [id])
  fileName     String
  totalRows    Int
  createdCount Int
  updatedCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  orders Order[]

  @@map("import_batches")
}

model Order {
  id                       String       @id @default(cuid())
  orderCode                String       @unique
  // ID nội bộ của đơn hàng bên AMIS (field "id") — dùng để upsert chính xác khi đồng bộ
  // tự động, phòng trường hợp sale_order_no bị sửa bên AMIS.
  amisOrderId              Int?         @unique
  // Nguồn dữ liệu: MANUAL | EXCEL_IMPORT | AMIS_API — hiển thị cho người dùng biết đơn
  // này đến từ đâu.
  source                   String       @default("MANUAL")
  customerName             String
  customerCode             String?
  salesEmployeeNameRaw     String?
  salesEmployeeId          String?
  salesEmployee            User?        @relation("OrderSalesEmployee", fields: [salesEmployeeId], references: [id])
  orderDate                DateTime?
  expectedDeliveryDate     DateTime?
  // Ngày giao hàng thực tế — lấy từ field "delivery_date" của AMIS CRM (khác với
  // deadline_date/expectedDeliveryDate là hạn giao dự kiến). Null nếu đơn nhập thủ công/
  // Excel (không có nguồn này) hoặc AMIS chưa điền.
  actualDeliveryDate       DateTime?
  status                   OrderStatus  @default(NEW)
  totalValue               Decimal      @default(0) @db.Decimal(18, 2)
  // Giá trị hàng đã giao cộng dồn — lấy từ field "total_amount_delivered_summary" của AMIS
  // CRM. Dùng để tính "giá trị còn lại chưa giao" (totalValue - deliveredValue) cho các đơn
  // giao một phần, thay vì tính cả giá trị đơn vào phần quá hạn/sắp đến hạn. Mặc định 0 cho
  // đơn nhập tay/Excel (chưa giao gì) — khi đó giá trị còn lại = toàn bộ giá trị đơn, đúng
  // hành vi cũ.
  deliveredValue           Decimal      @default(0) @db.Decimal(18, 2)
  // true khi đơn đã được đối chiếu và sửa thủ công từ nguồn đáng tin hơn AMIS CRM (vd Sổ chi
  // tiết bán hàng bên kế toán, khi phát hiện AMIS CRM báo sai/lỗi đồng bộ nội bộ AMIS) —
  // worker sync AMIS sẽ bỏ qua hoàn toàn đơn đã đánh dấu (không ghi đè, không xoá dù AMIS báo
  // loại trừ), coi như "đã khoá" theo kết quả đối chiếu thủ công.
  deliveryVerifiedManually Boolean      @default(false)
  deliveryVerifiedNote     String?
  poCode                   String?
  rawData                  Json?
  importBatchId            String?
  importBatch              ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  shipmentSlips  ShipmentSlip[]
  items          OrderItem[]
  deliveryEvents OrderDeliveryEvent[]

  @@index([salesEmployeeId])
  @@index([expectedDeliveryDate])
  @@index([status])
  @@map("orders")
}

// Lịch sử tăng/giảm giá trị đã giao (deliveredValue) của từng đơn qua mỗi lần đồng bộ AMIS
// (hoặc đối chiếu thủ công) — ghi 1 dòng "delta" (phần chênh lệch so với lần trước) mỗi khi
// phát hiện thay đổi, kèm thời điểm PHÁT HIỆN (occurredAt). Lý do cần bảng này: AMIS chỉ trả
// về giá trị đã giao LUỸ KẾ + ngày giao GẦN NHẤT của cả đơn (không có lịch sử từng đợt giao),
// nên đơn giao nhiều đợt trải qua nhiều tháng (vd đợt 1 tháng 7, đợt 2 tháng 8) nếu tính trực
// tiếp trên Order.actualDeliveryDate sẽ bị dồn hết vào tháng của đợt giao GẦN NHẤT, và số liệu
// tháng cũ có thể tự đổi khi có đợt giao mới — sai lệch cho báo cáo doanh số theo tháng. Ghi
// nhận delta ngay khi phát hiện giúp "doanh số tháng" ổn định theo thời gian, không bị dồn/đổi
// ngược — nhưng chỉ chính xác kể từ khi bảng này bắt đầu ghi (không truy hồi được lịch sử các
// đợt giao đã xảy ra trước đó, nên có 1 lần backfill duy nhất lúc thêm tính năng — xem
// migration liên quan).
model OrderDeliveryEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Chép lại salesEmployeeId của đơn tại thời điểm ghi — tránh phải join sang Order chỉ để
  // gộp theo nhân viên/tháng (truy vấn doanh số chạy thường xuyên, cần nhanh).
  salesEmployeeId String?
  // Phần chênh lệch giá trị đã giao so với lần đồng bộ trước — có thể ÂM nếu AMIS điều chỉnh
  // giảm (huỷ một phần, sửa lỗi nhập liệu...). Tổng các delta của 1 đơn luôn bằng
  // deliveredValue hiện tại của đơn đó.
  deltaValue          Decimal  @db.Decimal(18, 2)
  deliveredValueAfter Decimal  @db.Decimal(18, 2)
  // Thời điểm phát hiện delta này (giờ chạy đồng bộ, hoặc ngày backfill/đối chiếu thủ công) —
  // quyết định delta này tính vào "doanh số tháng" nào, và không đổi về sau.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([salesEmployeeId, occurredAt])
  @@map("order_delivery_events")
}

// Chi tiết mã hàng/số lượng/giá của đơn hàng — đồng bộ từ AMIS
// (sale_order_product_mappings) hoặc nhập tay khi tạo đơn thủ công.
model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineOrder          Int
  itemCode           String?
  itemName           String
  unit               String?
  quantity           Decimal @default(0) @db.Decimal(14, 2)
  unitPrice          Decimal @default(0) @db.Decimal(18, 2)
  totalPrice         Decimal @default(0) @db.Decimal(18, 2)
  warehouse          String?
  poCustomerItemCode String?

  @@index([orderId])
  @@index([itemCode])
  @@map("order_items")
}

// ---------- Phiếu đi hàng (upload ảnh + OCR) ----------

model ShipmentSlip {
  id              String  @id @default(cuid())
  slipNumber      String  @unique
  slipDate        DateTime?
  receiverName    String?
  customerName    String?
  deliveryAddress String?
  description     String?
  paymentMethod   String?
  preparedBy      String?
  // Null cho phiếu nhập từ Excel hàng loạt (không có ảnh/PDF gốc) — chỉ có giá trị khi phiếu
  // được tạo qua đường chụp ảnh/AI đọc (xem imageThumbPath).
  imagePath         String?
  imageThumbPath    String?
  orderId           String?
  order             Order?     @relation(fields: [orderId], references: [id])
  ocrRawResponse    Json?
  ocrConfidenceNote Json?
  status            SlipStatus @default(DRAFT)
  createdById       String
  createdBy         User       @relation("SlipCreatedBy", fields: [createdById], references: [id])
  // Phiếu tạo qua nhập Excel hàng loạt — giữ vết batch để đối chiếu/audit, null nếu tạo qua
  // đường ảnh/thủ công như trước.
  importBatchId String?
  importBatch   ShipmentSlipImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  items                  ShipmentSlipItem[]
  // Các đợt giao (PoDeliveryEvent) được TỰ SINH từ phiếu này khi khớp được với dòng PO tracking
  // — xem PoDeliveryEvent.sourceShipmentSlipId. Xoá phiếu thì xoá luôn các đợt giao tương ứng.
  generatedDeliveryEvents PoDeliveryEvent[]

  @@index([orderId])
  @@index([slipDate])
  @@map("shipment_slips")
}

// Nhập hàng loạt phiếu đi hàng từ Excel (thay cho AI đọc ảnh — chưa cấu hình được
// ANTHROPIC_API_KEY) — cùng cơ chế wizard chọn cột với Đơn hàng/Kế hoạch kinh doanh. 1 dòng
// Excel = 1 mã hàng của 1 phiếu; các dòng cùng Số phiếu được gộp lại thành 1 ShipmentSlip +
// nhiều ShipmentSlipItem. Upload lại cùng Số phiếu sẽ CẬP NHẬT (thay toàn bộ dòng hàng),
// không tạo trùng.
model ShipmentSlipImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  totalRows    Int
  createdCount Int
  updatedCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  slips ShipmentSlip[]

  @@map("shipment_slip_import_batches")
}

model ShipmentSlipItem {
  id                 String       @id @default(cuid())
  shipmentSlipId     String
  shipmentSlip       ShipmentSlip @relation(fields: [shipmentSlipId], references: [id], onDelete: Cascade)
  lineOrder          Int
  itemCode           String?
  itemName           String
  warehouse          String?
  poSaleNumber       String?
  unit               String?
  qtyRequested       Decimal?     @db.Decimal(14, 2)
  qtyActual          Decimal?     @db.Decimal(14, 2)
  poCustomerItemCode String?
  note               String?

  @@map("shipment_slip_items")
}

// ---------- Công nợ (đồng bộ từ congno.hienvi.me) ----------

model DebtSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime
  customerName    String
  customerCode    String?
  salesEmployeeId String?
  totalDebt       Decimal  @default(0) @db.Decimal(18, 2)
  overdueDebt     Decimal  @default(0) @db.Decimal(18, 2)
  agingBuckets    Json
  source          String   @default("HIENVI")
  rawData         Json?
  createdAt       DateTime @default(now())

  @@index([snapshotDate])
  @@index([customerName])
  @@map("debt_snapshots")
}

model SyncLog {
  id            String     @id @default(cuid())
  jobType       String
  status        SyncStatus
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  message       String?
  recordsSynced Int?
  triggeredBy   String?
  // Điểm đánh dấu tiến trình đồng bộ tăng dần (vd modified_date mới nhất đã xử lý của
  // AMIS) — dùng để lần chạy sau chỉ lấy dữ liệu mới/đã sửa thay vì kéo lại toàn bộ.
  cursor        String?

  @@index([jobType, startedAt])
  @@map("sync_logs")
}

// ---------- Kế hoạch kinh doanh ----------

model SalesTarget {
  id            String   @id @default(cuid())
  employeeId    String
  employee      User     @relation(fields: [employeeId], references: [id])
  year          Int
  month         Int
  targetRevenue Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@map("sales_targets")
}

// ---------- Kế hoạch kinh doanh chi tiết (import từ Excel) ----------
// Bổ sung cho SalesTarget (tổng theo nhân viên/tháng) — cho phép chi tiết hoá
// kế hoạch theo Nhân viên x Sản phẩm x Nhóm hàng, đọc từ file Excel kế hoạch.

model SalesPlanImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  year         Int
  month        Int
  totalRows    Int
  createdCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  lines SalesPlanLine[]

  @@map("sales_plan_import_batches")
}

model SalesPlanLine {
  id              String               @id @default(cuid())
  batchId         String
  batch           SalesPlanImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  employeeNameRaw String?
  employeeId      String?
  employee        User?                @relation(fields: [employeeId], references: [id])
  productCode     String?
  productName     String?
  productGroup    String?
  targetRevenue   Decimal              @default(0) @db.Decimal(18, 2)
  targetQuantity  Decimal?             @db.Decimal(14, 2)
  createdAt       DateTime             @default(now())

  @@index([year, month])
  @@index([employeeId])
  @@index([productCode])
  @@map("sales_plan_lines")
}

// ---------- Đăng ký đi công tác (gặp khách hàng) ----------
// NVKD tự đăng ký, Quản trị viên duyệt mới được ghi nhận vào KPI "Điểm Đi Gặp Khách".

model BusinessTripRequest {
  id           String     @id @default(cuid())
  employeeId   String
  employee     User       @relation("TripEmployee", fields: [employeeId], references: [id])
  visitDate    DateTime // Ngày đi
  expectedTime String? // Giờ dự kiến gặp (vd "09:30") — chỉ là mốc dự kiến, không phải DateTime đầy đủ
  companyName  String // Công ty đến gặp
  content      String // Nội dung buổi gặp
  status       TripStatus @default(PENDING)
  approvedById String?
  approvedBy   User?      @relation("TripApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([employeeId])
  @@index([visitDate])
  @@index([status])
  @@map("business_trip_requests")
}

// ---------- Biên bản hàng lỗi (Quản trị viên nhập, dùng tính KPI CSKH & Chất lượng) ----------

model DefectReport {
  id           String   @id @default(cuid())
  reportNumber String // Số biên bản hàng lỗi
  employeeId   String // NVKD chịu trách nhiệm
  employee     User     @relation("DefectEmployee", fields: [employeeId], references: [id])
  reportDate   DateTime @default(now())
  description  String // Nội dung lỗi
  createdById  String
  createdBy    User     @relation("DefectCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([reportDate])
  @@map("defect_reports")
}

// ---------- KPI đánh giá hàng tháng ----------
// Chỉ lưu các chỉ tiêu/số liệu KHÔNG tính tự động được từ dữ liệu hệ thống (Quản trị viên
// nhập tay) — Doanh số/Doanh số Sản xuất lấy từ SalesTarget + SalesPlanLine (Nhóm Sản xuất)
// đã có sẵn; Điểm Đi Gặp Khách đếm từ BusinessTripRequest đã duyệt trong tháng; Hàng lỗi đếm
// từ DefectReport trong tháng — không lưu lặp lại ở đây, tính trực tiếp lúc đọc báo cáo
// (xem apps/web/src/lib/kpi-metrics.ts) để không bị lệch dữ liệu giữa 2 nơi.
model KpiMonthlyEntry {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation("KpiEmployee", fields: [employeeId], references: [id])
  year       Int
  month      Int

  // 2. Giá bán cao (mã hàng bán cao hơn giá SX báo ≥3%) — đếm số mã hàng, nhập tay cả chỉ tiêu
  // lẫn thực tế (chưa có khái niệm "giá SX báo" trong dữ liệu đơn hàng).
  targetHighPriceSkuCount Int?
  actualHighPriceSkuCount Int?

  // 3. Phát triển khách hàng mới — chưa có khái niệm "khách hàng mới" trong dữ liệu đơn hàng.
  targetNewCustomers Int?
  actualNewCustomers Int?

  // 4. Công nợ — tạm thời nhập tay vì congno.hienvi.me chưa hoạt động (HIENVI_MOCK_MODE).
  debtOverduePct        Decimal? @db.Decimal(6, 2) // % công nợ quá hạn
  debtCollectionRatePct Decimal? @db.Decimal(6, 2) // % tỷ lệ thu hồi công nợ trong tháng

  // Chỉ tiêu số lượt đi gặp khách hàng/tháng — dùng quy đổi điểm từ số lượt đăng ký đã duyệt.
  visitTarget Int @default(8)

  // 6. Thái độ & kỷ luật
  attendanceDays Decimal? @db.Decimal(5, 2) // ngày công / 26
  violationCount Int?     @default(0)

  updatedById String?
  updatedBy   User?    @relation("KpiUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@map("kpi_monthly_entries")
}

// ---------- Theo dõi PO/giao hàng độc lập (nhập tay từ file Excel, KHÔNG qua AMIS) ----------
// Anh Quân trực tiếp theo dõi PO + từng đợt giao hàng trong 1 file Excel riêng (không đi qua
// AMIS CRM), gửi file cập nhật hàng ngày. Từ khi có tính năng này, đây là NGUỒN CHÍNH cho
// "Doanh số" / "Giá trị PO đặt hàng" toàn app (Tổng quan, Kế hoạch kinh doanh, KPI) — thay cho
// cách tính suy ra từ AMIS trước đó — vì file có sẵn NGÀY + SỐ LƯỢNG + GIÁ TRỊ của TỪNG đợt
// giao (tối đa 3 đợt/dòng hàng), chính xác hơn hẳn deliveredValue luỹ kế + 1 ngày giao duy
// nhất mà AMIS cung cấp. Trang "Tiến độ giao hàng" (quá hạn/sắp đến hạn theo đơn) KHÔNG đổi,
// vẫn dùng dữ liệu Order đồng bộ AMIS như cũ — 2 nguồn dữ liệu độc lập, phục vụ 2 mục đích
// khác nhau (quá hạn giao ở mức đơn vs. doanh số ở mức PO/mã hàng).
model PoTrackingImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  totalRows    Int
  createdCount Int
  updatedCount Int
  errorCount   Int
  errorReport  Json?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  lines PoTrackingLine[]

  @@map("po_tracking_import_batches")
}

model PoTrackingLine {
  id String @id @default(cuid())

  // Khoá tự nhiên để upsert đúng dòng khi file được gửi lại (PO/dòng hàng lặp lại mỗi lần gửi,
  // chỉ tiến độ giao hàng thay đổi) — ghép Số PO + Mã hàng (hoặc Tên SP nếu thiếu mã) + số thứ
  // tự xuất hiện trong PO đó (phòng trường hợp 1 PO có nhiều dòng cùng mã hàng). KHÔNG ghép số
  // lượng/giá vào khoá vì đây là các trường có thể được anh sửa lại theo thời gian.
  naturalKey String @unique

  // Mã NVKD gốc trong file (đã chuẩn hoá hoa/trim, vd "TANDT") — chỉ gán salesEmployeeId khi
  // khớp đúng 1 trong 4 nhân viên đang theo dõi (xác nhận qua đối chiếu tên khách hàng trùng
  // khớp với dữ liệu AMIS: TANDT=Đặng Văn Tấn, QUANDM=Đào Minh Quân, TUNGNT=Ngô Thanh Tùng,
  // DUNGP=Phạm Thị Dung). Các mã NVKD khác (nhân viên khác/cũ) vẫn lưu nguyên văn, không gán
  // tài khoản — theo đúng quyết định của anh, không tự suy đoán gán nhầm người.
  nvkdCodeRaw     String?
  salesEmployeeId String?
  salesEmployee   User?   @relation(fields: [salesEmployeeId], references: [id])

  customerCode          String? // "Mã khách hàng"
  poMonthLabel          String? // "Tháng PO" — chỉ tham khảo, mọi tính toán dùng poDate
  poCode                String // "Số PO"
  itemCode              String? // "Mã hàng"
  itemName              String? // "Tên SP"
  invoiceName           String? // "Tên Hoá đơn"
  customerItemCode      String? // "Mã KH" (mã hàng phía khách hàng)
  monthLabel            String? // "Tháng" — chỉ tham khảo
  poDate                DateTime?
  poQuantity            Decimal?  @db.Decimal(14, 2)
  unit                  String?
  actualPrice           Decimal?  @db.Decimal(18, 2) // "Giá thực"
  contractPrice         Decimal?  @db.Decimal(18, 2) // "Giá HĐ"
  requestedDeliveryDate DateTime? // "Ngày Y/C giao"
  note                  String?
  statusRaw             String? // "Trạng thái" (đã trim) — vd "Kết thúc", "Đang thực hiện"

  // totalDeliveredQty/remainingQty/deliveredValue/remainingValue/statusRaw là các trường TÍNH
  // LẠI (không ghi trực tiếp từ file Excel nữa) = "nền" từ lần nhập file PO tracking gần nhất
  // (baselineDeliveredQty/baselineDeliveredValue/baselineClosed) CỘNG THÊM các đợt giao qua
  // Phiếu đi hàng (PoDeliveryEvent.sourceShipmentSlipId khác null) — xem
  // lib/po-delivery-sync.ts. Nhờ tách "nền" riêng, gửi lại file PO tracking (ghi đè nền) sẽ
  // không làm mất phần đã giao qua Phiếu đi hàng đã ghi nhận trước đó.
  totalDeliveredQty Decimal? @db.Decimal(14, 2) // "Tổng SL giao" (đã tính lại)
  remainingQty      Decimal? @db.Decimal(14, 2) // "SL Chưa giao" (đã tính lại)

  poValue        Decimal @default(0) @db.Decimal(18, 2) // "G.Trị PO"
  deliveredValue Decimal @default(0) @db.Decimal(18, 2) // "G.Trị Thực giao" (đã tính lại)
  remainingValue Decimal @default(0) @db.Decimal(18, 2) // "G.Trị còn lại" (đã tính lại)
  content        String? // "Nội Dung"

  // "Nền" ghi từ đúng giá trị các cột tương ứng trong file PO tracking Excel tại lần nhập gần
  // nhất — KHÔNG hiển thị trực tiếp ở đâu, chỉ dùng làm gốc để cộng thêm phần giao qua Phiếu đi
  // hàng khi tính lại các trường ở trên.
  baselineDeliveredValue Decimal  @default(0) @db.Decimal(18, 2)
  baselineDeliveredQty   Decimal? @db.Decimal(14, 2)
  // true nếu file PO tracking Excel tự báo dòng này "Kết thúc" — 1 khi đã true thì trạng thái
  // tính lại luôn là "Kết thúc" (không tự mở lại), dù không có thêm đợt giao nào qua Phiếu đi hàng.
  baselineClosed Boolean @default(false)

  // Đóng thủ công qua nút "Kết thúc đơn" ở trang Tiến độ giao hàng — dùng khi PO không cần
  // giao tiếp dù chưa giao đủ SL/giá trị (vd khách huỷ bớt/không lấy nữa nhưng file PO tracking
  // Excel gốc chưa kịp cập nhật). Khác baselineClosed (chỉ đến từ file Excel): cờ này KHÔNG bị
  // 1 lần nhập lại file Excel ghi đè/mở lại — chỉ đổi qua đúng nút "Kết thúc đơn"/"Mở lại đơn".
  manuallyClosed         Boolean   @default(false)
  manuallyClosedAt       DateTime?
  manuallyClosedByUserId String?
  manuallyClosedByUser   User?     @relation("PoLineManuallyClosedBy", fields: [manuallyClosedByUserId], references: [id])

  importBatchId String?
  importBatch   PoTrackingImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  deliveryEvents PoDeliveryEvent[]

  @@index([salesEmployeeId])
  @@index([poDate])
  @@index([poCode])
  @@map("po_tracking_lines")
}

// 1 dòng = 1 đợt giao hàng thật (tách từ 3 cột "Ngày/SL/Giá trị giao lần 1/2/3" của
// PoTrackingLine) — cho phép cộng dồn theo tháng chính xác bằng 1 câu groupBy đơn giản, đúng
// bằng ngày/giá trị anh đã ghi nhận, không cần suy đoán/xấp xỉ như với dữ liệu AMIS.
model PoDeliveryEvent {
  id     String         @id @default(cuid())
  lineId String
  line   PoTrackingLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  // Chép lại salesEmployeeId của dòng tại thời điểm ghi — tránh phải join sang PoTrackingLine
  // chỉ để gộp theo nhân viên/tháng.
  salesEmployeeId String?
  eventDate       DateTime
  quantity        Decimal  @db.Decimal(14, 2)
  value           Decimal  @db.Decimal(18, 2)
  // đợt giao thứ 1/2/3 trong dòng PO này (từ file Excel) — 0 cho đợt sinh tự động từ Phiếu đi
  // hàng (xem sourceShipmentSlipId), không có ý nghĩa thứ tự thật.
  sequence Int

  // Khác null nếu đợt giao này được TỰ SINH khi nhập Phiếu đi hàng (khớp theo Số PO + Mã hàng)
  // thay vì đọc từ cột "Ngày/SL/GT giao lần 1/2/3" của file PO tracking Excel — dùng để: (1)
  // xoá đúng các đợt của 1 phiếu khi phiếu đó được nhập lại/sửa (không bị trùng), (2) tách riêng
  // khỏi các đợt do file PO tracking sinh ra khi tính lại PoTrackingLine (xem
  // lib/po-delivery-sync.ts).
  sourceShipmentSlipId String?
  sourceShipmentSlip   ShipmentSlip? @relation(fields: [sourceShipmentSlipId], references: [id], onDelete: Cascade)

  @@index([eventDate])
  @@index([salesEmployeeId, eventDate])
  @@index([sourceShipmentSlipId])
  @@map("po_delivery_events")
}
