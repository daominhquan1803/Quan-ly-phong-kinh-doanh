# Copy file này thành infra/.env trên VPS và điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env thật (đã có trong .gitignore).

# Username/tổ chức GitHub chứa image (dùng để "docker compose pull" đúng image từ GHCR)
GITHUB_REPOSITORY_OWNER=

# --- PostgreSQL ---
POSTGRES_USER=hoanggia
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
POSTGRES_DB=hoanggia_crm

# --- NextAuth ---
# Tạo secret ngẫu nhiên: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# Tên miền dùng cho nhãn Traefik (chỉ cần khi VPS đã có sẵn Traefik riêng —
# xem ghi chú "standalone-tls" profile trong docker-compose.yml). Phải khớp
# với domain trong NEXTAUTH_URL ở trên.
DOMAIN=your-domain.com
# Route Traefik thứ 2 (tuỳ chọn) — vd hostname VPS Hostinger cấp sẵn, dùng song song với DOMAIN.
# Để trống ("") nếu không cần route thứ 2.
EXTRA_DOMAIN=srv-your-vps.hstgr.cloud

# Múi giờ hệ thống cho container web/worker — LUÔN để Asia/Ho_Chi_Minh trừ khi có lý do khác,
# nếu không mọi phép tính ngày-tháng (tuần/tháng, lịch cron) sẽ lệch với giờ Việt Nam.
TZ=Asia/Ho_Chi_Minh

# --- AI OCR (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Token nội bộ giữa web <-> worker (tự đặt chuỗi ngẫu nhiên bất kỳ) ---
INTERNAL_SYNC_TOKEN=

# --- Đồng bộ đơn hàng trực tiếp từ MISA AMIS CRM Open API ---
# Lấy tại AMIS CRM: ⚙️ Cài đặt → Kết nối/API → khai báo AppID để có Mã bảo mật.
AMIS_APP_ID=
AMIS_CLIENT_SECRET=
AMIS_SYNC_CRON=0 6 * * *
AMIS_SYNC_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# --- Đồng bộ công nợ (congno.hienvi.me) ---
HIENVI_BASE_URL=https://congno.hienvi.me
HIENVI_USERNAME=
HIENVI_PASSWORD=
HIENVI_MOCK_MODE=false
# Đặt false khi trang congno.hienvi.me đang đóng/bảo trì để tạm dừng hẳn (không sinh dữ liệu giả,
# không ghi SyncLog) — đặt lại true (hoặc bỏ dòng này) khi có tài khoản thật và trang hoạt động.
HIENVI_SYNC_ENABLED=true
HIENVI_SYNC_CRON=30 6 * * *

# --- Đồng bộ Báo giá từ Google Sheet dùng chung của phòng ---
# ID lấy từ URL Google Sheet: https://docs.google.com/spreadsheets/d/<ID>/edit...
# Sheet phải đang bật chia sẻ "Bất kỳ ai có link đều xem được" — worker tải qua link export
# công khai, không đăng nhập/OAuth.
GOOGLE_SHEETS_QUOTE_ID=
QUOTE_SYNC_CRON=15 6 * * *
QUOTE_SYNC_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# --- Thông báo nhắc việc (Kế hoạch tuần sắp hết hạn + KPI tháng chậm tiến độ) ---
# Kiểm tra mỗi sáng — tự bỏ qua nếu chưa đúng mốc ngày cần nhắc, không cần đổi giờ theo mùa vụ.
NOTIFY_CRON=0 8 * * *
NOTIFY_CRON_TIMEZONE=Asia/Ho_Chi_Minh
# SMTP để gửi email nhắc việc thật (ngoài thông báo trong app) — dùng Gmail thì cần tạo "Mật khẩu
# ứng dụng" (App Password) tại myaccount.google.com/apppasswords, KHÔNG dùng mật khẩu Gmail
# thường. Để trống SMTP_USER/SMTP_PASSWORD thì chỉ có thông báo trong app, không gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Hoàng Gia CRM

# --- Thông báo đẩy lên điện thoại (Web Push — app cài từ PWA trên màn hình chính) ---
# Tạo 1 lần bằng: npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY web cũng cần (API /api/push/vapid-public-key trả cho trình duyệt), worker cần
# CẢ 2 khoá để gửi. Để trống thì chỉ có thông báo trong app + email, không có thông báo đẩy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email liên hệ theo yêu cầu chuẩn Web Push (dạng "mailto:...") — Google/trình duyệt dùng để liên
# hệ nếu phát hiện gửi push bất thường, không hiển thị cho người nhận.
VAPID_SUBJECT=mailto:sale5.hoanggiaps@gmail.com
