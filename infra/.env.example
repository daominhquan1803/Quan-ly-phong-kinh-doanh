# Copy file này thành infra/.env trên VPS và điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env thật (đã có trong .gitignore).

# Username/tổ chức GitHub chứa image (dùng để "docker compose pull" đúng image từ GHCR)
GITHUB_REPOSITORY_OWNER=

# --- PostgreSQL ---
POSTGRES_USER=hoanggia
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
POSTGRES_DB=hoanggia_crm

# --- NextAuth ---
# Tạo secret ngẫu nhiên: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# Tên miền dùng cho nhãn Traefik (chỉ cần khi VPS đã có sẵn Traefik riêng —
# xem ghi chú "standalone-tls" profile trong docker-compose.yml). Phải khớp
# với domain trong NEXTAUTH_URL ở trên.
DOMAIN=your-domain.com

# --- AI OCR (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Token nội bộ giữa web <-> worker (tự đặt chuỗi ngẫu nhiên bất kỳ) ---
INTERNAL_SYNC_TOKEN=

# --- Đồng bộ đơn hàng trực tiếp từ MISA AMIS CRM Open API ---
# Lấy tại AMIS CRM: ⚙️ Cài đặt → Kết nối/API → khai báo AppID để có Mã bảo mật.
AMIS_APP_ID=
AMIS_CLIENT_SECRET=
AMIS_SYNC_CRON=0 6 * * *
AMIS_SYNC_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# --- Đồng bộ công nợ (congno.hienvi.me) ---
HIENVI_BASE_URL=https://congno.hienvi.me
HIENVI_USERNAME=
HIENVI_PASSWORD=
HIENVI_MOCK_MODE=false
HIENVI_SYNC_CRON=30 6 * * *

# --- Đồng bộ Báo giá từ Google Sheet dùng chung của phòng ---
# ID lấy từ URL Google Sheet: https://docs.google.com/spreadsheets/d/<ID>/edit...
# Sheet phải đang bật chia sẻ "Bất kỳ ai có link đều xem được" — worker tải qua link export
# công khai, không đăng nhập/OAuth.
GOOGLE_SHEETS_QUOTE_ID=
QUOTE_SYNC_CRON=15 6 * * *
QUOTE_SYNC_CRON_TIMEZONE=Asia/Ho_Chi_Minh
